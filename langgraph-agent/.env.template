# ============================================================================
# IBM Consulting Advantage (ICA) Configuration (REQUIRED)
# ============================================================================
# Get these credentials from: https://agentstudio.servicesessentials.ibm.com

ICA_API_KEY=your-ica-api-key-here
ICA_API_BASE=https://agentstudio.servicesessentials.ibm.com
ICA_ORGANIZATION_ID=your-organization-id-here
ICA_PROJECT_ID=your-project-id-here
ICA_CONTEXT_ID=your-context-id-here
ICA_USE_CONTEXT_STUDIO=true

# ============================================================================
# OpenAI-compatible Configuration (for LiteLLM)
# ============================================================================
# These should match your ICA credentials
OPENAI_API_KEY=your-ica-api-key-here
OPENAI_API_BASE=https://agentstudio.servicesessentials.ibm.com/api/v1

# ============================================================================
# Agent Configuration
# ============================================================================
AGENT_NAME=agentic-devops-langgraph
AGENT_VERSION=1.0.0
AGENT_DESCRIPTION=Multi-agent system for DevOps automation, code review, and service orchestration
AGENT_PORT=8000
AGENT_HOST=0.0.0.0

# ============================================================================
# Model Configuration
# ============================================================================
DEFAULT_MODEL=gpt-5.2-chat
SUPERVISOR_MODEL=gpt-5.2-chat
DEVOPS_MODEL=gpt-5.2-chat
REVIEW_MODEL=gpt-5.2-chat
ORCHESTRATOR_MODEL=gpt-5.2-chat
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=4096

# ============================================================================
# OpenTelemetry (OTEL) Configuration
# ============================================================================
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector:4317
OTEL_SERVICE_NAME=langgraph-agent
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=development

# ============================================================================
# MCP (Model Context Protocol) Configuration
# ============================================================================
MCP_ENABLED=false
MCP_SERVER_URL=https://mcp-gateway.ibm.com
MCP_VIRTUAL_SERVER_ID=your-virtual-server-id

# ============================================================================
# Enterprise Advantage A2A Protocol Configuration
# ============================================================================
A2A_ENABLED=true
A2A_PROTOCOL=json-rpc
A2A_VERSION=2.0

# Auto-registration with Agentic Studio
# Note: Currently agents must be registered via UI, not API
AUTO_REGISTRATION_ENABLED=false
AGENTIC_STUDIO_URL=https://agentstudio.servicesessentials.ibm.com
REGISTRATION_RETRY_ATTEMPTS=3
REGISTRATION_RETRY_DELAY=5
HEARTBEAT_INTERVAL=60

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=

# ============================================================================
# Performance Configuration
# ============================================================================
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=300
ENABLE_CACHING=true
CACHE_TTL=3600

# ============================================================================
# Security Configuration
# ============================================================================
ENABLE_AUTH=false
API_KEY_HEADER=X-API-Key
ALLOWED_ORIGINS=["*"]

# ============================================================================
# Development Configuration
# ============================================================================
DEBUG=false
RELOAD=false